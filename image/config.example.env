WIFI_PRIMARY_SSID=Home
WIFI_SECONDARY_SSID=Baiamonte
# Use WIFI_PSK only when both networks share a password. Otherwise set both:
WIFI_PRIMARY_PSK=replace-primary-password
WIFI_SECONDARY_PSK=replace-secondary-password
WIFI_COUNTRY=US
KIOSK_PROFILE=auto
KIOSK_VARIANT=baiamonte
BAIAMONTE_TV_URL=
KIOSK_PORT=8999
KIOSK_UPDATE_BRANCH=main
KIOSK_REPO_URL=https://github.com/OWNER/tv-kiosk.git
SSH_PUBLIC_KEY_FILE=image/kiosk_admin_ed25519.pub
# Optional private profile downloaded from CloudConnexa > Networks > Connectors.
# This file is embedded with mode 0600 and is never copied into the Git repository.
CLOUDCONNEXA_PROFILE_FILE=image/cloudconnexa-baiamonte-dashboard.ovpn

# VPN-free Pi 4 Mom dual-display image. Create Cloudflare Tunnel published
# applications and protect all four hostnames with one Access service token.
# KIOSK_PROFILE=multi
# KIOSK_VARIANT=mom
# MOM_BAIAMONTE_ORIGIN=https://baiamonte-tv.example.com
# MOM_MIAMI_ADSB_ORIGIN=https://miami-adsb.example.com
# MOM_MIAMI_AIRPORT_ORIGIN=https://miami-airport.example.com
# MOM_MIAMI_AIS_ORIGIN=https://miami-ais.example.com
# CLOUDFLARE_ACCESS_CLIENT_ID=replace.access
# CLOUDFLARE_ACCESS_CLIENT_SECRET=replace-with-service-token-secret
# Alternatively, keep both values in a private JSON file containing
# client_id/client_secret and point the builder at it:
# MOM_ACCESS_CREDENTIALS_FILE=/private/path/mom-kiosk-access.json
