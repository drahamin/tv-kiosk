#!/bin/sh
set -eu

BOOTSTRAP_ENV=${BOOTSTRAP_ENV:-/etc/tv-kiosk/bootstrap.env}
LOG_FILE=/var/log/tv-kiosk-firstboot.log

if [ -r "$BOOTSTRAP_ENV" ]; then
  # This file is generated into the image and contains only kiosk settings.
  . "$BOOTSTRAP_ENV"
fi

: "${KIOSK_PORT:=8999}"
: "${KIOSK_UPDATE_BRANCH:=main}"
: "${KIOSK_REPO_URL:=}"
: "${WIFI_COUNTRY:=US}"
: "${WIFI_PRIMARY_SSID:=Home}"
: "${WIFI_SECONDARY_SSID:=Baiamonte}"
: "${KIOSK_PROFILE:=auto}"
: "${KIOSK_VARIANT:=auto}"
: "${BAIAMONTE_TV_URL:=http://192.168.0.10:8101}"

progress() {
  printf '\n\033[1;36m[%s/6]\033[0m \033[1m%s\033[0m\n' "$1" "$2"
}

failed() {
  status=$?
  if [ "$status" -eq 0 ]; then
    return
  fi

  printf '\n\033[1;31mINSTALLATION PAUSED\033[0m\n'
  printf 'The kiosk will retry automatically in 30 seconds.\n'
  printf 'Recent details:\n\n'
  tail -n 12 "$LOG_FILE" 2>/dev/null || true
  sleep 30
}
trap failed EXIT

: > "$LOG_FILE"
setfont /usr/share/consolefonts/Lat15-TerminusBold32x16.psf.gz 2>/dev/null || true
printf '\033[2J\033[H'
printf '\033[1;44;37m                                                    \033[0m\n'
printf '\033[1;44;37m              RAHAMIN KIOSK SETUP                  \033[0m\n'
printf '\033[1;44;37m                                                    \033[0m\n'
printf '\nKeep this Raspberry Pi powered on. No input is required.\n'
printf 'Initial setup normally takes 10 to 25 minutes.\n'

HARDWARE_MODEL=$(tr -d '\000' < /proc/device-tree/model 2>/dev/null || printf 'Raspberry Pi')
case "$HARDWARE_MODEL" in
  *"Raspberry Pi Zero"*|*"Raspberry Pi 3"*|*"Raspberry Pi 4"*|*"Raspberry Pi 5"*)
    printf 'Detected supported hardware: %s\n' "$HARDWARE_MODEL"
    ;;
  *)
    printf 'Detected hardware: %s (continuing with standard settings)\n' "$HARDWARE_MODEL"
    ;;
esac

progress 1 'Starting unattended kiosk setup'
printf 'Boot services are ready.\n'

progress 2 'Connecting to Wi-Fi and the internet'
if command -v raspi-config >/dev/null 2>&1; then
  raspi-config nonint do_wifi_country "$WIFI_COUNTRY" >> "$LOG_FILE" 2>&1 || true
fi
rfkill unblock wifi >> "$LOG_FILE" 2>&1 || true
nmcli radio wifi on >> "$LOG_FILE" 2>&1 || true
systemctl restart NetworkManager.service >> "$LOG_FILE" 2>&1 || true
nmcli connection reload >> "$LOG_FILE" 2>&1 || true
nmcli device set wlan0 managed yes >> "$LOG_FILE" 2>&1 || true
nmcli device wifi rescan ifname wlan0 >> "$LOG_FILE" 2>&1 || true
# Pi Zero Wi-Fi is 2.4 GHz only. Try both preloaded roaming profiles explicitly
# instead of relying on NetworkManager's background autoconnect timing.
for wifi_ssid in "$WIFI_PRIMARY_SSID" "$WIFI_SECONDARY_SSID"; do
  if nmcli --wait 25 connection up "Rahamin WiFi $wifi_ssid" ifname wlan0 >> "$LOG_FILE" 2>&1; then
    break
  fi
done
if ! nm-online --wait-for-startup --quiet --timeout=180 >> "$LOG_FILE" 2>&1; then
  printf 'Wi-Fi is not ready yet. A retry will start automatically.\n' >> "$LOG_FILE"
  exit 1
fi
NETWORK_ADDRESS=$(hostname -I 2>/dev/null | awk '{print $1}')
printf 'Network connected.\n'
if [ -n "$NETWORK_ADDRESS" ]; then
  printf 'Device address: %s\n' "$NETWORK_ADDRESS"
  printf 'Remote maintenance: kiosk@%s\n' "$NETWORK_ADDRESS"
fi

if [ -n "$KIOSK_REPO_URL" ]; then
  progress 3 'Installing GitHub download support'
  apt-get update >> "$LOG_FILE" 2>&1
  DEBIAN_FRONTEND=noninteractive apt-get install -y git >> "$LOG_FILE" 2>&1
  export KIOSK_APT_UPDATED=1

  progress 4 'Downloading the latest kiosk from GitHub'
  rm -rf /opt/tv-kiosk
  git clone --branch "$KIOSK_UPDATE_BRANCH" --single-branch "$KIOSK_REPO_URL" /opt/tv-kiosk >> "$LOG_FILE" 2>&1
  INSTALLER=/opt/tv-kiosk/install.sh
else
  progress 3 'Preparing the built-in kiosk package'
  printf 'Using the image\047s built-in kiosk files.\n'
  progress 4 'Checking the built-in kiosk package'
  INSTALLER=/opt/tv-kiosk-bootstrap/install.sh
fi

progress 5 'Installing the browser and full-screen display'
printf 'The display software is being checked and configured.\n'
KIOSK_PORT="$KIOSK_PORT" KIOSK_UPDATE_BRANCH="$KIOSK_UPDATE_BRANCH" KIOSK_PROFILE="$KIOSK_PROFILE" KIOSK_VARIANT="$KIOSK_VARIANT" BAIAMONTE_TV_URL="$BAIAMONTE_TV_URL" "$INSTALLER" >> "$LOG_FILE" 2>&1

progress 6 'Setup complete — starting Rahamin Kiosk'
systemctl disable tv-kiosk-firstboot.service >> "$LOG_FILE" 2>&1
sync
printf '\nThe Raspberry Pi will reboot in 5 seconds.\n'
printf 'After reboot, the TV will show its DHCP address and configuration instructions.\n'
if [ -n "${NETWORK_ADDRESS:-}" ]; then
  printf 'Maintenance address: kiosk@%s\n' "$NETWORK_ADDRESS"
fi
trap - EXIT
sleep 5
reboot
