<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <keyboard>
    <keybind key="A-W-h">
      <action name="HideCursor" />
      <action name="WarpCursor" x="-1" y="-1" />
    </keybind>
  </keyboard>
  <windowRules>
    <!-- Dual-HDMI Pi 4/5 mode launches undecorated app windows.
         Move them first, then maximize them so each TV receives one kiosk. -->
    <windowRule identifier="*RahaminPrimary*">
      <action name="MoveToOutput" output="HDMI-A-1" />
      <action name="Maximize" />
    </windowRule>
    <windowRule identifier="*BaiamonteSecondary*">
      <action name="MoveToOutput" output="HDMI-A-2" />
      <action name="Maximize" />
    </windowRule>
    <!-- Chromium's native Wayland app-id varies across releases. The dual
         mode uses XWayland for deterministic coordinates, with this title
         rule retained as a safe placement fallback. -->
    <windowRule title="*Tenuta Baiamonte Live*">
      <action name="MoveToOutput" output="HDMI-A-2" />
      <action name="Maximize" />
    </windowRule>
  </windowRules>
</labwc_config>
