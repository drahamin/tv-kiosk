<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <keyboard>
    <keybind key="A-W-h">
      <action name="HideCursor" />
      <action name="WarpCursor" x="-1" y="-1" />
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*chromium*">
      <action name="ToggleFullscreen" />
    </windowRule>
  </windowRules>
</labwc_config>
