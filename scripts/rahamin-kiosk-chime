#!/bin/sh
# PipeWire can still be settling immediately after an update; retry briefly.
set -u

attempt=1
while [ "$attempt" -le 3 ]; do
  if /usr/bin/python3 /opt/tv-kiosk/scripts/startup-chime.py | /usr/bin/pw-cat --playback --raw --rate=48000 --channels=2 --channel-map=stereo --format=s16 --volume=0.25 -; then
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 1
done

echo "Rahamin Kiosk: startup twinkle could not reach HDMI audio" >&2
exit 1
