#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "Rahamin Kiosk system action must run as root" >&2
  exit 1
fi

case "${1:-}" in
  force-update)
    systemctl start --no-block tv-kiosk-update.service
    ;;
  reboot)
    systemd-run --quiet --unit=rahamin-kiosk-reboot --on-active=3s /usr/bin/systemctl reboot
    ;;
  start-display)
    rm -f /home/kiosk/.config/tv-kiosk/display-disabled
    runuser -u kiosk -- env XDG_RUNTIME_DIR=/run/user/"$(id -u kiosk)" systemctl --user enable --now tv-kiosk-browser.service
    ;;
  stop-display)
    install -m 0600 -o kiosk -g kiosk /dev/null /home/kiosk/.config/tv-kiosk/display-disabled
    runuser -u kiosk -- env XDG_RUNTIME_DIR=/run/user/"$(id -u kiosk)" systemctl --user disable --now tv-kiosk-browser.service
    ;;
  remove-vpn)
    systemctl disable --now tv-kiosk-cloudconnexa.service >/dev/null 2>&1 || true
    if nmcli -g connection.id connection show baiamonte-dashboard >/dev/null 2>&1; then
      nmcli --wait 30 connection down baiamonte-dashboard >/dev/null 2>&1 || true
      nmcli connection delete baiamonte-dashboard >/dev/null
    fi
    rm -f \
      /etc/tv-kiosk/cloudconnexa-baiamonte-dashboard.ovpn \
      /var/lib/rahamin-kiosk/cloudconnexa-profile.sha256 \
      /run/tv-kiosk/cloudconnexa-status.json \
      /home/kiosk/.config/systemd/user/tv-kiosk-browser.service.d/10-baiamonte-browser.conf
    runuser -u kiosk -- env XDG_RUNTIME_DIR=/run/user/"$(id -u kiosk)" systemctl --user daemon-reload
    runuser -u kiosk -- env XDG_RUNTIME_DIR=/run/user/"$(id -u kiosk)" systemctl --user restart tv-kiosk-browser.service
    ;;
  *)
    echo "Allowed actions: force-update, reboot, start-display, stop-display, remove-vpn" >&2
    exit 2
    ;;
esac

