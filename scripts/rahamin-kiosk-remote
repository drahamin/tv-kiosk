#!/bin/sh
# Translate Samsung Anynet+ (HDMI-CEC) remote presses into Wayland keys.
set -u

KIOSK_VARIANT=${KIOSK_VARIANT:-auto}

find_cec_device() {
  fallback=
  device_count=0
  for device in /dev/cec*; do
    [ -c "$device" ] || continue
    device_count=$((device_count + 1))
    [ -n "$fallback" ] || fallback=$device
    # A Pi 4/5 exposes one CEC adapter per HDMI connector. Probe without
    # changing power or active-source state and prefer an adapter whose DRM
    # connector has received a real physical address from EDID. This remains
    # reliable during boot, before libCEC's active scan can see the TV.
    if command -v cec-ctl >/dev/null 2>&1 &&
      timeout 5 cec-ctl -d "$device" 2>/dev/null |
      grep -Eq 'Physical Address[[:space:]]*:[[:space:]]*[0-9a-e]\.[0-9a-e]\.[0-9a-e]\.[0-9a-e]'; then
      printf '%s\n' "$device"
      return
    fi
    if printf 'scan\n' | timeout 7 cec-client -s -d 8 -t p -o "Rahamin Kiosk" "$device" 2>&1 |
      grep -q "device #0: TV"; then
      printf '%s\n' "$device"
      return
    fi
  done
  # A single-adapter Pi can safely use its only device. With dual HDMI, an
  # unaddressed fallback is usually the wrong connector, so wait and retry.
  if [ "$device_count" -eq 1 ]; then
    printf '%s\n' "$fallback"
  fi
}

send_key() {
  wtype -P "$1" -p "$1"
}

send_control_key() {
  wtype -M ctrl -P "$1" -p "$1" -m ctrl
}

cec_action() {
  case "$1" in
    *"key pressed: up"*) echo up ;;
    *"key pressed: down"*) echo down ;;
    *"key pressed: left"*) echo previous_page ;;
    *"key pressed: right"*) echo next_page ;;
    *"key pressed: select"*|*"key pressed: enter"*) echo select ;;
    *"key pressed: page up"*) echo previous_page ;;
    *"key pressed: page down"*) echo next_page ;;
    *"key pressed: play/pause"*|*"key pressed: play"*|*"key pressed: pause"*) echo play_pause ;;
    *"key pressed: fast forward"*|*"key pressed: forward"*|*"key pressed: channel up"*) echo zoom_in ;;
    *"key pressed: rewind"*|*"key pressed: backward"*|*"key pressed: channel down"*) echo zoom_out ;;
    *"key pressed: stop"*|*"key pressed: number0"*|*"key pressed: 0"*) echo zoom_reset ;;
  esac
}

send_action() {
  case "$1" in
    up|down) send_key "$1" ;;
    previous_page)
      if [ "$KIOSK_VARIANT" = baiamonte ]; then
        send_key left
      else
        systemctl --user kill --kill-whom=main --signal=SIGUSR2 tv-kiosk-browser.service
      fi
      ;;
    next_page)
      if [ "$KIOSK_VARIANT" = baiamonte ]; then
        send_key right
      else
        systemctl --user kill --kill-whom=main --signal=SIGUSR1 tv-kiosk-browser.service
      fi
      ;;
    select)
      send_key Return
      ;;
    play_pause) send_key space ;;
    zoom_in) send_control_key plus ;;
    zoom_out) send_control_key minus ;;
    zoom_reset) send_control_key 0 ;;
  esac
}

echo "Rahamin Kiosk Samsung remote listener starting"
while :; do
  # Register passively as a playback device. Do not send libCEC's `as`
  # (active-source) command here: it powers on many Samsung TVs and selects
  # the Pi's HDMI input whenever this service or the GitHub updater restarts.
  # When the TV is already on this listener still receives its Anynet+ keys.
  cec_device=$(find_cec_device)
  if [ -z "$cec_device" ]; then
    echo "No HDMI-CEC adapter found; retrying in 5 seconds" >&2
    sleep 5
    continue
  fi
  echo "Listening for Samsung remote commands on $cec_device"
  cec-client -t p -d 31 -o "Rahamin Kiosk" "$cec_device" </dev/null 2>&1 | while IFS= read -r line; do
    case "$line" in
      # libCEC 6 and 7 format key events differently. Accept both forms and
      # suppress the duplicate detail/canonical pair emitted for each press.
      *"key pressed:"*)
        action=$(cec_action "$line")
        [ -n "$action" ] || continue
        now_ms=$(date +%s%3N)
        if [ "${last_action:-}" = "$action" ] && [ $((now_ms - ${last_action_ms:-0})) -lt 350 ]; then
          continue
        fi
        last_action=$action
        last_action_ms=$now_ms
        echo "$line"
        send_action "$action"
        ;;
    esac
  done
  echo "HDMI-CEC listener stopped; retrying in 3 seconds" >&2
  sleep 3
done
