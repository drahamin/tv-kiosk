#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "Rahamin Kiosk cleanup must run as root" >&2
  exit 1
fi

STATE_DIR=/var/lib/rahamin-kiosk
MARKER="$STATE_DIR/cleanup-v1"
if [ -e "$MARKER" ]; then
  exit 0
fi

# These services are not used by the kiosk. Keep networking, SSH, the graphical
# session, Chromium, audio, mDNS, and all Raspberry Pi platform services intact.
for unit in bluetooth.service rpcbind.service rpcbind.socket nfs-blkmap.service; do
  systemctl disable --now "$unit" >/dev/null 2>&1 || true
done

apt-get clean
journalctl --vacuum-size=50M >/dev/null 2>&1 || true
find '/home/kiosk/.config/chromium/Crash Reports' -type f -mtime +7 -delete 2>/dev/null || true
find /home/kiosk/.cache -type f -name '*.old' -mtime +7 -delete 2>/dev/null || true
install -d -m 0755 "$STATE_DIR"
touch "$MARKER"
