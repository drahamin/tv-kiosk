[Unit]
Description=Rahamin Kiosk lightweight HDMI audio routing
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/opt/tv-kiosk/scripts/rahamin-kiosk-audio
RemainAfterExit=yes

[Install]
WantedBy=default.target
